# --- rmbridge -------------------------------------------------------------
# cloud = via reMarkable cloud (rmapi), usb = tablet plugged in over USB
RM_BACKEND=cloud
# Optional: protect the web UI with HTTP basic auth (any username)
APP_PASSWORD=

# Host folder with your PDFs/EPUBs (mounted at /nas in the container)
NAS_SHARE=/mnt/nas/books

# User the containers run as. 1993 is the uid livesync-bridge's image uses,
# so both can write the shared vault folder. Must be able to write NAS_SHARE.
PUID=1993
PGID=1993

# --- Obsidian bridge (optional) -------------------------------------------
# Folder inside the shared vault mirror (see docs/obsidian-livesync.md)
VAULT_DIR=/vault
VAULT_OUTBOX=Outbox
VAULT_INBOX=Inbox
# Folder on the tablet that mirrors the vault
RM_VAULT_FOLDER=/Obsidian
# Seconds between automatic vault syncs (0 = only when you press the button)
SYNC_INTERVAL=300
