# ===========================================================================
#  rmbridge settings — copy to .env and fill in. Restart after changing:
#    docker compose up -d        (or: uv run rmbridge)
# ===========================================================================

# --- reMarkable ------------------------------------------------------------
# cloud = via reMarkable cloud (rmapi), usb = tablet plugged in over USB
RM_BACKEND=cloud
# Folder on the tablet that syncs with Obsidian
RM_VAULT_FOLDER=/Obsidian

# --- NAS -------------------------------------------------------------------
# Host folder with your PDFs/EPUBs (shown in the left pane)
NAS_SHARE=/mnt/nas/books

# Folders on the NAS (inside NAS_SHARE) that are copied to the tablet
# automatically, every SYNC_INTERVAL seconds. Comma-separated, each one
# "nas folder:tablet folder"; without ":..." the tablet folder gets the same name.
#   NAS_SYNC=Books                       NAS_SHARE/Books -> /Books
#   NAS_SYNC=Books:/Library, Papers/ML   ... and NAS_SHARE/Papers/ML -> /ML
# One way only: new PDFs/EPUBs are sent once; deleting one on the tablet is fine.
NAS_SYNC=

# --- Obsidian Self-hosted LiveSync -----------------------------------------
# Copy these from Obsidian → Settings → Self-hosted LiveSync → Remote database.
# Leave LIVESYNC_URL empty to turn the Obsidian sync off.
LIVESYNC_URL=https://couchdb.example.lan
LIVESYNC_DATABASE=obsidian
LIVESYNC_USERNAME=admin
LIVESYNC_PASSWORD=

# End-to-end encryption passphrase (leave empty if E2EE is off)
LIVESYNC_PASSPHRASE=
# Path obfuscation passphrase — usually the same as the E2EE passphrase if
# "Path obfuscation" is on; leave empty if it's off
LIVESYNC_OBFUSCATE_PASSPHRASE=
# Only for newer E2EE vaults: Settings → Self-hosted LiveSync →
# "Show current recovery code" (looks like sls-id-v1:...). Leave empty otherwise.
LIVESYNC_ID_KEY=

# Vault folder that is mirrored with RM_VAULT_FOLDER on the tablet, both ways.
# Only this folder leaves CouchDB. Notes go over as PDFs; ink comes back as PDFs.
LIVESYNC_VAULT_FOLDER=reMarkable

# Seconds between tablet syncs (CouchDB ⇄ folder is live, this is folder ⇄ tablet,
# and also how often NAS_SYNC folders are checked)
SYNC_INTERVAL=120

# --- Web UI ----------------------------------------------------------------
# Protect the UI with HTTP basic auth (any username). Recommended.
APP_PASSWORD=
PORT=8484

# --- Docker ----------------------------------------------------------------
# User the container runs as; must be able to write ./data and NAS_SHARE
PUID=1000
PGID=1000
